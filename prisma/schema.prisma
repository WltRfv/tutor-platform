generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  STUDENT
  TEACHER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GameType {
  CARDS
  MATCHING
  FIND_ERROR
  QUIZ
  TRAINER
  HINTS
  QUEST
}

// ============================================
// USER
// ============================================

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String
  password        String
  role            Role              @default(STUDENT)
  status          ApplicationStatus @default(PENDING)
  grade           Int?
  grades          Int[]             @default([])
  phone           String?
  messengerLink   String?
  messengerType   String?
  messengerHandle String?
  theme           String?
  accentDark      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  activities        Activity[]
  submissions       Submission[]
  notes             Note[]               @relation("TeacherNotes")
  codeRuns          CodeRun[]
  lessons           Lesson[]             @relation("UserLessons")
  taughtLessons     Lesson[]             @relation("TeacherLessons")
  homeworkCreated   Homework[]           @relation("TeacherHomework")
  homeworkTargeted  Homework[]           @relation("UserHomeworkTarget")
  homeworkSubmitted HomeworkSubmission[]
  userSubjects      UserSubject[]
  testsCreated      Test[]               @relation("TeacherTests")
  questions         Question[]
  retakeRequests    RetakeRequest[]
  topicUnlocks      TopicUnlock[]
  notificationReads NotificationRead[]
  homeworkStarts    HomeworkStart[]
  lessonPlans       LessonPlan[]         @relation("TeacherLessonPlans")
  presentationsCreated Presentation[]    @relation("TeacherPresentations")
  selfWorkStatuses  SelfWorkStatus[]

  // Игры
  gamesCreated     Game[]           @relation("TeacherGames")
  gameSessions     GameSession[]
  assignedGames    AssignedGame[]   @relation("AssignedToUser")
  assignedByMe     AssignedGame[]   @relation("AssignedByTeacher")
}

// ============================================
// SUBJECTS
// ============================================

model Subjects {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String
  grade     Int?
  color     String   @default("purple")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        UserSubject[]
  notes        Note[]
  tests        Test[]
  homeworks    Homework[]
  lessons      Lesson[]
  questions    Question[]
  topics       Topic[]
  lessonPlans  LessonPlan[]
  presentations Presentation[]
  games        Game[]

  @@map("Subjects")
}

model UserSubject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subjects @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  addedBy   String   @default("AUTO")
  createdAt DateTime @default(now())

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
}

// ============================================
// TOPICS
// ============================================

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subjects @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes        Note[]
  tests        Test[]
  homeworks    Homework[]
  unlocks      TopicUnlock[]
  lessonPlans  LessonPlan[]
  presentations Presentation[]
  games        Game[]

  @@index([subjectId, order])
}

model TopicUnlock {
  id         String   @id @default(cuid())
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentIds Json?
  unlockedAt DateTime @default(now())

  @@unique([topicId, userId])
  @@index([userId])
}

// ============================================
// NOTES
// ============================================

model Note {
  id              String   @id @default(cuid())
  title           String
  content         String
  practiceContent String?
  selfWorkContent String?
  presentationId  String?
  presentation    Presentation? @relation("NotePresentation", fields: [presentationId], references: [id], onDelete: SetNull)
  subjectId       String
  subject         Subjects @relation(fields: [subjectId], references: [id])
  topicId         String?
  topic           Topic?   @relation(fields: [topicId], references: [id])
  topicName       String?
  imageUrl        String?
  published       Boolean  @default(false)
  authorId        String
  author          User     @relation("TeacherNotes", fields: [authorId], references: [id])
  createdAt       DateTime @default(now())

  selfWorkStatuses SelfWorkStatus[]

  @@index([presentationId])
}

model LessonPlan {
  id        String   @id @default(cuid())
  title     String
  subjectId String
  subject   Subjects @relation(fields: [subjectId], references: [id])
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id])
  topicName String?
  content   String
  duration  Int      @default(45)
  published Boolean  @default(false)
  authorId  String
  author    User     @relation("TeacherLessonPlans", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([topicId])
}

model SelfWorkStatus {
  id             String    @id @default(cuid())
  noteId         String
  note           Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING")
  studentAnswer  String?
  teacherComment String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([noteId, userId])
  @@index([userId])
  @@index([noteId])
}

// ============================================
// QUESTIONS
// ============================================

model Question {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subjects @relation(fields: [subjectId], references: [id])

  topic      String
  difficulty Int    @default(2)
  type       String @default("SINGLE_CHOICE")

  text     String
  imageUrl String?

  options      Json?
  correct      Int?
  correctMulti Json?
  correctText  String?
  matchMode    String?
  correctNumber Float?
  tolerance     Float?  @default(0.01)
  correctBool   Boolean?

  explanation String?
  source      String?
  points      Int     @default(1)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  gameItems GameItem[]

  @@index([subjectId, topic])
  @@index([difficulty])
  @@index([type])
}

// ============================================
// TESTS
// ============================================

model Test {
  id    String @id @default(cuid())
  title String

  subjectId String
  subject   Subjects @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   User   @relation("TeacherTests", fields: [teacherId], references: [id])

  mode String

  questions  Json?
  bankConfig Json?

  timeLimit       Int?
  attemptsAllowed Int     @default(1)
  topicId         String?
  topic           Topic?  @relation(fields: [topicId], references: [id])

  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions    Submission[]
  retakeRequests RetakeRequest[]

  @@index([teacherId, createdAt])
}

model Submission {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  testId String?
  test   Test?   @relation(fields: [testId], references: [id])

  version Int @default(1)

  questions Json @default("[]")
  answers   Json @default("[]")

  code     String?
  language String?
  answer   Json?

  score  Int?
  status String @default("PENDING")

  createdAt DateTime @default(now())

  @@unique([testId, userId, version])
  @@index([userId, createdAt])
}

model RetakeRequest {
  id String @id @default(cuid())

  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status String @default("PENDING")

  reason      String?
  teacherNote String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([testId, userId])
  @@index([status])
}

// ============================================
// HOMEWORK
// ============================================

model Homework {
  id          String  @id @default(cuid())
  title       String
  description String?

  subjectId String
  subject   Subjects @relation(fields: [subjectId], references: [id])

  topicId   String?
  topic     Topic?  @relation(fields: [topicId], references: [id])
  topicName String?

  imageUrl String?
  dueDate  DateTime?

  targetType   String  @default("ALL")
  targetUserId String?
  targetUser   User?   @relation("UserHomeworkTarget", fields: [targetUserId], references: [id])

  teacherId String
  teacher   User   @relation("TeacherHomework", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       HomeworkTask[]
  submissions HomeworkSubmission[]
  starts      HomeworkStart[]

  @@index([teacherId, createdAt])
  @@index([subjectId])
  @@index([targetUserId])
}

model HomeworkTask {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  order      Int      @default(0)

  text     String
  imageUrl String?

  correctAnswer String?
  answerType    String  @default("TEXT")
  points        Int     @default(1)

  language    String?
  starterCode String?

  createdAt DateTime @default(now())

  @@index([homeworkId, order])
}

model HomeworkSubmission {
  id String @id @default(cuid())

  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  version Int @default(1)

  boardData   Json?
  previewUrl  String?
  files       Json?
  textAnswer  String?
  taskAnswers Json?

  autoCheckPassed  Boolean?
  autoCheckMessage String?
  autoScore        Int?
  autoTotal        Int?

  status         String  @default("SUBMITTED")
  teacherComment String?
  gradeEmoji     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiReview        String?
  aiReviewScore   Int?
  aiReviewedAt    DateTime?
  taskCodes       Json?
  timeSpent       Int?
  taskCodesMetrics Json?

  @@index([homeworkId, userId, version])
  @@index([homeworkId, createdAt])
}

// ============================================
// LESSONS
// ============================================

model Lesson {
  id            String   @id @default(cuid())
  title         String?
  subjectId     String
  subject       Subjects @relation(fields: [subjectId], references: [id])
  startAt       DateTime
  endAt         DateTime
  telemostLink  String?
  boardLink     String?
  googleEventId String?
  status        String   @default("SCHEDULED")
  notes         String?

  userId String
  user   User   @relation("UserLessons", fields: [userId], references: [id])

  teacherId String?
  teacher   User?   @relation("TeacherLessons", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, startAt])
  @@index([teacherId, startAt])
}

// ============================================
// ACTIVITY / CODE RUNS
// ============================================

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model CodeRun {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  language String
  code     String
  output   String?
  stderr   String?
  status   String  @default("SUCCESS")

  totalChars     Int?   @default(0)
  pastedChars    Int?   @default(0)
  typedChars     Int?   @default(0)
  typingDuration Int?   @default(0)
  pasteCount     Int?   @default(0)
  avgTypingSpeed Float? @default(0)
  aiSuspicion    Int?   @default(0)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([aiSuspicion])
}

// ============================================
// NOTIFICATIONS
// ============================================

model NotificationRead {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  lastReadAt DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

model HomeworkStart {
  id           String   @id @default(cuid())
  homeworkId   String
  homework     Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@unique([homeworkId, userId])
  @@index([userId])
}

// ============================================
// PRESENTATIONS
// ============================================

model Presentation {
  id        String   @id @default(cuid())
  title     String
  subjectId String
  subject   Subjects @relation(fields: [subjectId], references: [id])
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id])
  topicName String?
  imageUrl  String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation("TeacherPresentations", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slides Slide[]
  notes  Note[] @relation("NotePresentation")

  @@index([subjectId])
  @@index([topicId])
  @@index([authorId])
}

model Slide {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  order          Int          @default(0)
  title          String?
  content        String
  imageUrl       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([presentationId])
}

// ============================================
// ATTACHMENTS
// ============================================

model Attachment {
  id           String   @id @default(cuid())
  ownerId      String
  name         String
  url          String
  mime         String?
  size         Int?
  noteId       String?
  testId       String?
  homeworkId   String?
  lessonPlanId String?
  createdAt    DateTime @default(now())

  @@index([ownerId])
  @@index([noteId])
  @@index([testId])
  @@index([homeworkId])
  @@index([lessonPlanId])
}

// ============================================
// GAMES — базовые модели под все механики
// ============================================

model Game {
  id          String    @id @default(cuid())
  type        GameType
  title       String
  description String?

  subjectId String
  subject   Subjects @relation(fields: [subjectId], references: [id])

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id])

  authorId String
  author   User   @relation("TeacherGames", fields: [authorId], references: [id])

  isTemplate Boolean @default(false)
  published  Boolean @default(false)
  settings   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       GameItem[]
  sessions    GameSession[]
  assignments AssignedGame[]

  // Для квестов: какие игры входят в этот квест как уровни
  questLevels GameQuestLevel[] @relation("QuestLevels")

  // Для квестов: какие квесты используют эту игру как уровень
  usedInQuests GameQuestLevel[] @relation("LevelGameUsage")

  @@index([authorId, createdAt])
  @@index([subjectId])
  @@index([topicId])
  @@index([isTemplate])
  @@index([type])
}

model GameItem {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  order   Int   @default(0)
  payload Json

  // Для QUIZ и TRAINER — ссылка на существующий Question
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  answers GameAnswer[]

  @@index([gameId, order])
  @@index([questionId])
}

model GameSession {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status String @default("IN_PROGRESS")

  score        Int?
  totalPoints  Int?
  percent      Float?
  correctCount Int?
  wrongCount   Int?
  skippedCount Int?
  durationSec  Int?
  metadata     Json?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt

  answers GameAnswer[]

  @@index([userId, startedAt])
  @@index([gameId, startedAt])
  @@index([status])
}

model GameAnswer {
  id        String @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  itemId String?
  item   GameItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  answer       Json?
  isCorrect    Boolean?
  selfMarked   Boolean?
  points       Int     @default(0)
  timeSpentMs  Int?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([itemId])
}

model AssignedGame {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("AssignedToUser", fields: [userId], references: [id], onDelete: Cascade)

  assignedById String
  assignedBy   User   @relation("AssignedByTeacher", fields: [assignedById], references: [id])

  isRequired Boolean   @default(true)
  dueDate    DateTime?
  status     String    @default("PENDING")

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([gameId, userId])
  @@index([userId, status])
  @@index([dueDate])
}

model GameQuestLevel {
  id      String @id @default(cuid())
  questId String
  quest   Game   @relation("QuestLevels", fields: [questId], references: [id], onDelete: Cascade)

  levelId String
  level   Game   @relation("LevelGameUsage", fields: [levelId], references: [id], onDelete: Cascade)

  order Int     @default(0)
  title String?

  createdAt DateTime @default(now())

  @@index([questId, order])
  @@index([levelId])
}